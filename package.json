{
  "name": "tokens-agogo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "ds:build": "node --env-file-if-exists=.env.local tools/build-chained-tokens.mjs",
    "ds:verify": "node --env-file-if-exists=.env.local tools/verify-chained.mjs",
    "ds:assets": "node --env-file-if-exists=.env.local tools/copy-ds-assets.mjs",
    "ds:specimens": "node --env-file-if-exists=.env.local tools/build-specimens.mjs",
    "ds:sync": "pnpm ds:build && pnpm ds:assets && pnpm ds:specimens && pnpm ds:usage && pnpm ds:figma",
    "ds:usage": "node --env-file-if-exists=.env.local tools/build-usage-index.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "ds:figma": "node tools/build-figma-tokens.mjs",
    "ds:emit": "node tools/emit-style-dictionary.mjs"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "culori": "^4.0.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.17.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@agorapulse/ui-symbol": "22.0.0",
    "@tailwindcss/postcss": "^4",
    "@types/culori": "^4.0.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "style-dictionary": "3.9.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.19.0"
}
